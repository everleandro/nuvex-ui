{
  "name": "nuvex-ui",
  "type": "module",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "private": false,
  "module": "./dist/nuvex-ui.es.js",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/nuvex-ui.umd.js",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/nuvex-ui.es.js",
      "require": "./dist/nuvex-ui.umd.js"
    },
    "./framework.scss": {
      "import": "./dist/styles/main.scss",
      "require": "./dist/styles/main.scss"
    },
    "./styles.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    },
    "./setting.scss": {
      "import": "./dist/styles/override/tokens/index.scss",
      "require": "./dist/styles/override/tokens/index.scss"
    },
    "./mixin.scss": {
      "import": "./dist/styles/_mixins.scss",
      "require": "./dist/styles/_mixins.scss"
    },
    "./package.json": {
      "import": "./package.json",
      "require": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everleandro/nuvex-ui.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "brace-expansion@^5.0.0": "^5.0.5",
    "brace-expansion@^2.0.0": "^2.0.3"
  },
  "keywords": [
    "vue",
    "vue3",
    "component",
    "material",
    "library",
    "ui framework",
    "vue framework",
    "ui library",
    "component library",
    "material components",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n playground,docs -c blue,yellow \"npm:playground:dev\" \"npm:docs:dev\"",
    "playground:dev": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "playground:preview": "vite preview --config playground/vite.config.ts",
    "build": "vite build && vue-tsc --emitDeclarationOnly && node ./scripts/prepare-dist.mjs",
    "build:types": "vue-tsc --emitDeclarationOnly && node ./scripts/prepare-dist.mjs",
    "pack:local": "npm run build && npm pack",
    "prepublishOnly": "npm run test && npm run build",
    "preserve": "vite build",
    "serve": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs --port 5176",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "vue": "^3.3.11"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "@microsoft/api-extractor": "^7.57.7",
    "@types/node": "^20.19.37",
    "@vitejs/plugin-vue": "^6.0.5",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "sass": "^1.98.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-css-injected-by-js": "^3.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vitepress": "^2.0.0-alpha.17",
    "vue-router": "^4.2.5",
    "vue-tsc": "^3.2.6"
  }
}
